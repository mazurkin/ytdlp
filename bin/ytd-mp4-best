#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail
set -o monitor
set -o noglob

export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1

exec conda run --no-capture-output --live-stream --name ytdlp \
    yt-dlp \
        -f "bestvideo[height<=1080][vcodec^=avc][ext=mp4]+bestaudio[ext=m4a][acodec^=aac]/best[ext=mp4]/best" \
        "$@"
